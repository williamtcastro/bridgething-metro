{
  "id": "01a14748-8c1a-771b-844d-4f10909667c9",
  "name": "Metro",
  "version": "1.0.0",
  "description": "A Windows Phone style Start screen: live tiles, knob navigation, panorama sections.",
  "icon": "icon.svg",
  "settings": "settings.html",
  "settingsHint": "theme and accent, start tiles (show, hide, size, order), weather and the music knob",
  "config": [
    {
      "type": "enum",
      "data": {
        "key": "theme",
        "label": "Background",
        "choices": [
          "dark",
          "light"
        ],
        "default": "dark"
      }
    },
    {
      "type": "string",
      "data": {
        "key": "accent",
        "label": "Accent color (pick from swatches in Metro settings)",
        "pattern": "^(lime|green|emerald|teal|cyan|cobalt|indigo|violet|pink|magenta|crimson|red|orange|amber|yellow|brown|olive|steel|mauve|sienna)$",
        "default": "cyan"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "music_knob",
        "label": "Knob on the music screen",
        "choices": [
          "volume",
          "scroll"
        ],
        "default": "volume"
      }
    },
    {
      "type": "enum",
      "data": {
        "key": "weather_units",
        "label": "Weather units",
        "choices": [
          "metric",
          "imperial"
        ],
        "default": "metric"
      }
    },
    {
      "type": "string",
      "data": {
        "key": "weather_location",
        "label": "Weather location as lat,lon (blank uses the phone's location)"
      }
    }
  ],
  "overlays": {
    "volume": false
  },
  "permissions": [
    "net.fetch",
    "geo"
  ],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "role": "launcher"
}
